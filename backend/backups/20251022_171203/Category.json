[{"_id":"68e9c5fc8ab275013f4632b1","name":"市场微观结构","description":"利用指令流、流动性、交易规则等短期市场非有效性盈利","parent":null,"tags":["订单 流动"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T02:50:36.463Z","updatedAt":"2025-10-11T02:50:36.463Z","__v":0,"children":[{"_id":"68e9c80c32ab26b6253ed201","name":"高频做市","description":"策略通过同时挂出买单和卖单，捕捉买卖价差。近5年，算法和硬件竞争白热化，已成为顶级量化私募的标配，但壁垒极高，对系统延迟要求是微秒乃至纳秒级。","parent":"68e9c5fc8ab275013f4632b1","tags":["实时"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T02:59:24.363Z","updatedAt":"2025-10-11T02:59:24.363Z","__v":0,"children":[]},{"_id":"68e9c90332ab26b6253ed214","name":"统计套利","description":"经典策略，寻找历史价格走势相关的股票配对，当价差偏离历史均值时，做多弱势股、做空强势股，期待价差回归。近年的发展在于使用更多元化的因子和更复杂的协整模型来寻找配对关系。","parent":"68e9c5fc8ab275013f4632b1","tags":["套利","配对交易"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:03:31.219Z","updatedAt":"2025-10-11T03:03:31.219Z","__v":0,"children":[]},{"_id":"68e9c93f32ab26b6253ed228","name":"订单簿分析","description":"通过分析限价订单簿的深度、买卖单不平衡、大单冲击等微观信息，预测极短期的价格动向。这是高频交易策略的核心之一，严重依赖高质量的快照数据。","parent":"68e9c5fc8ab275013f4632b1","tags":["订单簿","短息波动"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:04:31.893Z","updatedAt":"2025-10-11T03:04:31.893Z","__v":0,"children":[]}]},{"_id":"68e9c67a32ab26b6253ed1ca","name":"基本面量化","description":"将传统基本面分析标准化、系统化，持有周期通常为中长期","parent":null,"tags":["基本面 周期"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T02:52:42.144Z","updatedAt":"2025-10-11T02:52:42.145Z","__v":0,"children":[{"_id":"68e9c97632ab26b6253ed23d","name":"多因子模型","description":"量化领域的基石。通过价值、成长、质量、动量、波动率等一系列因子综合评估股票，构建投资组合。近5年的演进在于：因子挖掘更精细（如分析师预期修正、管理层行为等）；因子失效与轮动研究更深入；风控模型更严密。","parent":"68e9c67a32ab26b6253ed1ca","tags":["因子"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:05:26.594Z","updatedAt":"2025-10-11T03:05:26.594Z","__v":0,"children":[]},{"_id":"68e9c9c232ab26b6253ed253","name":"风格轮动","description":"又称因子择时，用来判断当前市场环境下哪种因子风格（如价值/成长、大盘/小盘）更有效，并动态调整因子暴露。通常使用宏观经济指标、市场情绪、动量等作为轮动信号的依据。","parent":"68e9c67a32ab26b6253ed1ca","tags":["轮动 择时 风格"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:06:42.334Z","updatedAt":"2025-10-11T03:06:42.334Z","__v":0,"children":[]},{"_id":"68ebaa3707b0b01192b06f5b","name":"趋势跟踪","description":"趋势跟踪策略的核心逻辑是捕捉价格持续上涨或下跌的惯性，通过技术指标识别趋势方向并跟随交易。MACD（移动平均收敛发散指标）通过计算股票价格的长期移动平均线和短期移动平均线之间的差异来发现市场趋势的变化。当 MACD 的快速线向上穿过慢速线，产生 “金叉”，通常被视为买入信号；当快速线向下穿过慢速线时产生 “死叉”，通常被视为卖出信号，以此来指导交易决策，跟随趋势进行买卖操作。","parent":"68e9c67a32ab26b6253ed1ca","tags":["趋势","技术指标"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-12T13:16:39.903Z","updatedAt":"2025-10-12T13:16:39.903Z","__v":0,"children":[]}]},{"_id":"68e9c6a832ab26b6253ed1d6","name":"大数据挖掘","description":"寻求传统数据之外的信息优势，是近年量化发展的最前沿","parent":null,"tags":["大数据"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T02:53:28.818Z","updatedAt":"2025-10-11T02:53:28.818Z","__v":0,"children":[{"_id":"68e9cb8c32ab26b6253ed26a","name":"空间信息","description":"通过分析停车场车辆数量预测零售商业绩，通过跟踪油轮储量预测原油价格。数据获取和处理成本高，但Alpha潜力巨大。","parent":"68e9c6a832ab26b6253ed1d6","tags":["卫星 地理"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:14:20.612Z","updatedAt":"2025-10-11T03:14:20.612Z","__v":0,"children":[]},{"_id":"68e9cbce32ab26b6253ed282","name":"网络舆情","description":"利用NLP技术分析新闻、社交媒体、财经论坛的文本情绪，捕捉市场情绪变化对股价的短期影响。","parent":"68e9c6a832ab26b6253ed1d6","tags":["NLP 论坛 市场情绪"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:15:26.118Z","updatedAt":"2025-10-11T03:15:26.118Z","__v":0,"children":[]},{"_id":"68e9cc0a32ab26b6253ed29b","name":"消费数据","description":"通过爬虫获取电商平台的销售数据，早于公司财报洞察消费品牌的经营状况。","parent":"68e9c6a832ab26b6253ed1d6","tags":["电商","财报","经营状况"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:16:26.779Z","updatedAt":"2025-10-11T03:16:26.779Z","__v":0,"children":[]}]},{"_id":"68e9c6e032ab26b6253ed1e3","name":"宏观与板块轮动","description":"基于宏观经济变量预测大类资产或行业板块的相对表现","parent":null,"tags":["经济变量","行业板块","大类资产"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T02:54:24.531Z","updatedAt":"2025-10-11T02:54:24.531Z","__v":0,"children":[{"_id":"68e9cc6d32ab26b6253ed2b5","name":"资产配置","description":"如风险平价模型，根据不同资产的风险贡献来分配权重，以求在各类市场环境下都能保持稳定的风险敞口。近年与机器学习结合，发展出动态风险平价等模型。","parent":"68e9c6e032ab26b6253ed1e3","tags":["风险权重","动态平衡"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:18:05.257Z","updatedAt":"2025-10-11T03:18:05.257Z","__v":0,"children":[]},{"_id":"68e9ccbb32ab26b6253ed2d0","name":"板块轮动","description":"又称行业轮动，根据经济周期（如美林时钟的量化版）、利率环境、产业政策等宏观指标，超配预期表现好的行业，低配预期表现差的行业。","parent":"68e9c6e032ab26b6253ed1e3","tags":["经济周期","利率 宏观指标"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:19:23.947Z","updatedAt":"2025-10-11T03:19:23.947Z","__v":0,"children":[]}]},{"_id":"68e9c71c32ab26b6253ed1f1","name":"机器学习","description":"不预设线性关系，让算法从数据中自动学习复杂模式","parent":null,"tags":["非线性","机器学习"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T02:55:24.532Z","updatedAt":"2025-10-11T02:55:24.532Z","__v":0,"children":[{"_id":"68e9cdaf32ab26b6253ed2ec","name":"监督学习","description":"将股价涨跌或收益率作为预测目标，使用如梯度提升树、神经网络等模型，从海量因子中学习非线性关系。这是目前中低频量化策略研发的主流方法。","parent":"68e9c71c32ab26b6253ed1f1","tags":["梯度提升树","神经网络","预测目标","非线性"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:23:27.615Z","updatedAt":"2025-10-11T03:23:27.615Z","__v":0,"children":[]},{"_id":"68e9ce1832ab26b6253ed326","name":"强化学习","description":"让AI智能体在模拟的交易环境中通过试错学习最优的交易策略。目前仍在探索阶段，面临过拟合严重、环境模拟不真实等挑战，但被认为是未来发展的方向之一。","parent":"68e9c71c32ab26b6253ed1f1","tags":["环境模拟","试错"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:25:12.820Z","updatedAt":"2025-10-11T03:25:12.820Z","__v":0,"children":[]},{"_id":"68e9ce6a32ab26b6253ed364","name":"无监督学习","description":"使用聚类分析等方法对股票进行重新分类，发现传统行业分类之外的结构性特征，用于优化组合或发现新的套利机会。","parent":"68e9c71c32ab26b6253ed1f1","tags":["聚类","优化组合"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:26:34.791Z","updatedAt":"2025-10-11T03:26:34.791Z","__v":0,"children":[]},{"_id":"68e9cea732ab26b6253ed383","name":"深度学习","description":"主要应用于：\n- 阿尔法生成： 使用深度神经网络直接从另类数据（如图像、文本）或高频数据中提取特征。\n- 组合优化： 直接优化整个投资组合的权重，而非单个资产的评分。","parent":"68e9c71c32ab26b6253ed1f1","tags":["神经网络","权重组合"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:27:35.712Z","updatedAt":"2025-10-11T03:27:35.712Z","__v":0,"children":[]}]},{"_id":"68e9c80c32ab26b6253ed201","name":"高频做市","description":"策略通过同时挂出买单和卖单，捕捉买卖价差。近5年，算法和硬件竞争白热化，已成为顶级量化私募的标配，但壁垒极高，对系统延迟要求是微秒乃至纳秒级。","parent":"68e9c5fc8ab275013f4632b1","tags":["实时"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T02:59:24.363Z","updatedAt":"2025-10-11T02:59:24.363Z","__v":0,"children":[]},{"_id":"68e9c90332ab26b6253ed214","name":"统计套利","description":"经典策略，寻找历史价格走势相关的股票配对，当价差偏离历史均值时，做多弱势股、做空强势股，期待价差回归。近年的发展在于使用更多元化的因子和更复杂的协整模型来寻找配对关系。","parent":"68e9c5fc8ab275013f4632b1","tags":["套利","配对交易"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:03:31.219Z","updatedAt":"2025-10-11T03:03:31.219Z","__v":0,"children":[]},{"_id":"68e9c93f32ab26b6253ed228","name":"订单簿分析","description":"通过分析限价订单簿的深度、买卖单不平衡、大单冲击等微观信息，预测极短期的价格动向。这是高频交易策略的核心之一，严重依赖高质量的快照数据。","parent":"68e9c5fc8ab275013f4632b1","tags":["订单簿","短息波动"],"visibility":"public","archived":false,"isSystem":false,"createdAt":"2025-10-11T03:04:31.893Z","updatedAt":"2025-10-11T03:04:31.893Z","__v":0,"children":[]},{"_id":"68e9c97632ab26b6253ed23d","name":"多因子模型","description":"量化领域的基石。通过价值、成长、质量、动量、波动率等一系列因子综合评估股票，构建投资组合。近5年的演进在于：因子挖掘更精细（如分析师预期修正、管理层行为等）；因子失效与轮动研究更深入；风控模型更严密。","parent":"68e9c67a32ab26b6253ed1ca"